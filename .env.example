# --- Vercel / Next.js (Project Settings > Environment Variables) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# --- Google Sheets mirror (optional, off by default) ---
# Set to "on" only after deploying the sheets-sync Edge Function, or the
# settings panel will offer a feature that cannot work.
# NEXT_PUBLIC_SHEETS_SYNC=on
# NEXT_PUBLIC_GOOGLE_SA_EMAIL=zakat-sync@your-project.iam.gserviceaccount.com

# --- Supabase Edge Function secrets (supabase secrets set ...) ---
# Not used by the Next.js app. See README step 5.
# GOOGLE_SA_EMAIL=zakat-sync@your-project.iam.gserviceaccount.com
# GOOGLE_SA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
